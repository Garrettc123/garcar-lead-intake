NODE_ENV=production
PORT=3000

# Required for authenticated administrative endpoints.
ADMIN_API_TOKEN=replace-with-long-random-token

# Optional security hardening when behind trusted proxy/load balancer.
ENFORCE_TLS_HEADERS=true

# Abuse protection.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Graceful shutdown timeout for SIGTERM/SIGINT.
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
